#!/bin/sh
#
# rc.d script for running a NetBBS node under NetBSD (design doc §2.1
# Tier 1, issue #82).
#
# PROVIDE: netbbs
# REQUIRE: NETWORKING SERVERS
# KEYWORD: shutdown
#
# rc.conf(5) variables:
#
#	netbbs=YES			# enable the service
#	netbbs_user="netbbs"		# unprivileged user to run as
#	netbbs_config="/usr/pkg/etc/netbbs/netbbs.toml"
#	netbbs_python="/usr/pkg/bin/python3.12"
#
# Install: copy this file from the official GitHub release/source tree to
# /etc/rc.d/netbbs, add netbbs=YES to /etc/rc.conf, then run
# `service netbbs start`. NetBBS itself is not distributed via pkgsrc.
#
# Build/run-tested on real NetBSD hardware (design doc §2.1 Tier 1).

. /etc/rc.subr

name="netbbs"
rcvar=${name}
: ${netbbs_user:="netbbs"}
: ${netbbs_config:="/usr/pkg/etc/netbbs/netbbs.toml"}
: ${netbbs_python:="/usr/pkg/bin/python3.12"}
: ${netbbs_ld_library_path:="/usr/pkg/lib"}

pidfile="/var/run/${name}.pid"
procname="${netbbs_python}"

# netbbs_ld_library_path (operator guide §1b): a `cryptography` built
# against pkgsrc's openssl links against /usr/pkg/lib/libssl.so.3, but
# NetBSD's runtime linker doesn't search /usr/pkg/lib by default and
# the base system's own /usr/lib/libssl.so.16 can't satisfy that
# SONAME -- confirmed on real hardware as an `import asyncssh` failure
# ("Shared object libssl.so.3 not found") even though the package is
# correctly installed. Only matters when the ssh extra is in use;
# harmless otherwise. Set empty in rc.conf to disable.
LD_LIBRARY_PATH="${netbbs_ld_library_path}"
export LD_LIBRARY_PATH

# NetBBS deliberately never daemonizes itself (design doc §13.8): it
# runs in the foreground and expects a supervisor to background and
# restart it. daemon(8) (in the NetBSD base system since 8.0) does
# exactly that -- forks the command into the background, writes the
# real child's pid to $pidfile, and redirects its stdio -- so rc.subr's
# ordinary start/stop/status logic works against that pidfile as usual.
command="/usr/bin/daemon"
command_args="-p ${pidfile} -u ${netbbs_user} -- ${netbbs_python} -m netbbs --config ${netbbs_config}"

load_rc_config $name
run_rc_command "$1"
